{
  "name": "ngx-view-morph-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "projects/ngx-view-morph"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-view-morph",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-view-morph --no-watch && ng test demo --no-watch",
    "test:ui": "ng test --ui",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@changesets/cli": "^2.31.0",
    "@vitest/ui": "5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.8",
    "ng-packagr": "^21.2.0",
    "shiki": "^4.6.0",
    "typescript": "~5.9.2",
    "vite-plus": "1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,html,scss,json}": "vp check --fix"
  },
  "packageManager": "bun@1.4.2"
}
